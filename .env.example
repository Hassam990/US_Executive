# =============================================
# US Executive Travel — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================

# Clerk session verification (the publishable key is also used by the client build)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY

# Server
PORT=5000
NODE_ENV=development

# ── JWT ──────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters. Use a long random value in production.
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# ── Admin ─────────────────────────────────────
# Use a strong password — not 'admin123'
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins (localhost ports are automatically permitted in dev)
CORS_ORIGIN=https://us-executivetravel.com,http://localhost:5173

# ── IONOS Exchange SMTP ───────────────────────
SMTP_HOST=smtp.exchange2019.ionos.co.uk
SMTP_PORT=587
EMAIL_USER=hello@us-executivetravel.com
EMAIL_PASS=REPLACE_WITH_MAILBOX_PASSWORD
EMAIL_RECEIVER=hello@us-executivetravel.com

# ── Supabase ──────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret. Never rename this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# ── Google OAuth ──────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
